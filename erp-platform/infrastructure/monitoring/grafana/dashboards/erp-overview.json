{
 "uid": "erp-overview",
 "title": "ERP platform overview",
 "tags": [
  "erp"
 ],
 "timezone": "utc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-3h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(erp_http_requests_total[5m]))",
     "legendFormat": "all",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "5xx error ratio",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(erp_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(erp_http_requests_total[5m]))",
     "legendFormat": "5xx",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "p95 latency",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(erp_http_request_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Slowest routes (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(erp_http_request_seconds_bucket[5m]))))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Status codes",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(erp_http_requests_total[5m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Tenants by status",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "erp_tenants",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Outbox: oldest pending event age",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "erp_outbox_oldest_pending_age_seconds",
     "legendFormat": "age",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Outbox: pending / dead-lettered",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "erp_outbox_pending_events",
     "legendFormat": "pending",
     "refId": "A"
    },
    {
     "expr": "erp_outbox_dead_events",
     "legendFormat": "dead",
     "refId": "B"
    }
   ]
  },
  {
   "id": 9,
   "type": "stat",
   "title": "Rejected /metrics scrapes",
   "datasource": {
    "type": "prometheus",
    "uid": null
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "increase(erp_security_events_total{event=\"metrics_unauthorized\"}[1h])",
     "legendFormat": "unauthorized",
     "refId": "A"
    }
   ]
  }
 ]
}