export DJANGO_DEBUG=true
export DJANGO_SETTINGS_MODULE=config.settings
export DB_NAME=erp_e2e DB_USER=postgres DB_HOST=localhost DB_PORT=5433
export ERP_BASE_DOMAIN=erp.localhost ERP_PLATFORM_HOST=platform.erp.localhost ERP_PUBLIC_SCHEME=http
export OIDC_ISSUER=http://localhost:8080/realms/erp
export OIDC_CLIENT_SECRET=<from the erp-bff client credentials tab>
export KEYCLOAK_ADMIN_CLIENT_SECRET=<from the erp-identity-admin client credentials tab>
export KEYCLOAK_BFF_CLIENT_UUID=<uuid of erp-bff> KEYCLOAK_SPA_CLIENT_UUID=<uuid of erp-spa>
export ERP_TOKEN_ENCRYPTION_KEY=$(python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
export CELERY_TASK_ALWAYS_EAGER=true
